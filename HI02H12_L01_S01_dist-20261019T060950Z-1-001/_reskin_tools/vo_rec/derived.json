  "vo_recap_purn_name": "पूर्ण विराम",
  "vo_recap_purn_when": "बात पूरी होने पर",
  "vo_stamp1_hint2": "इस वाक्य में प्रश्न पूछा जा रहा है, सही विराम चिह्न वाला ठप्पा चुनिए और वाक्य के अंत में लगाइए ।",
  "vo_stamp1_hint3": "नमस्ते दादाजी, आप कैसे हैं? यह एक प्रश्न है । प्रश्न पूछने पर प्रश्न वाचक चिह्न लगाया जाता है ।",
  "vo_stamp2_hint2": "इस वाक्य में कई सारी चीजों के नाम बताए जा रहे हैं । सही विराम चिह्न वाला ठप्पा चुनिए और वाक्य के बीच और अंत में लगाइए।",
  "vo_stamp2_hint3": "माँ ने मुझे मेरे जन्मदिन पर कई सारे खिलौने, पेन और किताबें दिलाई हैं । वाक्य में थोड़ा रुकने पर अल्प विराम और वाक्य पूरा होने पर पूर्ण विराम लगाया जाता है ।",
  "vo_stamp3_hint2": "यह एक सरल वाक्य है, सही विराम वाला ठप्पा चुनिए और वाक्य के अंत में लगाइए ।",
  "vo_stamp3_hint3": "मुझे उपहार बहुत पसंद हैं । वाक्य पूरा होने पर पूर्णविराम लगाया जाता है ।",
  "vo_stamp4_hint2": "इस वाक्य को देखिए, सही विराम चिह्न चुनिए ।",
  "vo_stamp4_hint3_alp": "इस वाक्य में हम थोड़ा रुक रहे हैं, यहाँ अल्प विराम आएगा ।",
  "vo_stamp4_hint3_prashn": "यहाँ प्रश्न पूछा जा रहा है, इसके अंत में प्रश्न वाचक चिह्न आएगा ।",
  "vo_stamp4_hint3_purn": "यह सरल वाक्य है इसके अंत में पूर्ण विराम आएगा ।",
  "vo_stamp4_intro": "इन वाक्यों को सुनकर देखिए और वाक्य में सही जगह पर विराम चिह्न लगाइए ।",
  "vo_stamp_intro": "यह वाक्य पढ़िए और वाक्य में सही जगह पर सही ठप्पा लगाइए ।",
